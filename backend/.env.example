# BlockVerify backend secrets — copy to `.env` and fill in.
# `.env` is gitignored; never commit real keys.

# Google Gemini API keys for the in-app assistant (/api/chat).
# Comma-separated POOL — the server rotates round-robin and benches any key that reports
# quota exhaustion, so one exhausted key does not take the assistant offline.
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEYS=key_one_here,key_two_here,key_three_here

# Single-key form is still honoured if you only have one:
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=25

# Bitcoin Testnet WIF private key for the OP_RETURN anchoring wallet.
# Testnet only — no real-money value. If unset, a throwaway demo key is used.
BTC_WIF=your_bitcoin_testnet_wif_here

# Port for the Flask server (Render sets this automatically).
# PORT=5000
