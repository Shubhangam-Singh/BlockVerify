  ChainSession ..> SurvivalConfig : reads
  ChainSession "1" --> "1" KeyRegistry : registers the hospitals' keys
  ChainSession "1" --> "many" FoldCommitter : for_fold()
  FoldCommitter --> Defences : applies
  FoldCommitter --> MeteredAnchor : anchors with
  FoldCommitter ..> CommitResult : returns
  ChainAnchor <|-- MeteredAnchor
  ChainAnchor --> Blockchain : mines blocks on
  Blockchain "1" *-- "many" Block
  Aggregator <|-- FedAvg
  Aggregator <|-- Forensics
  Draft --> Results : reads
  Collector --> Results : reads
