# /etc/blockverify.env — read by the blockverify systemd service.
# setup.sh copies this file there (root-only, mode 600). Edit it with:
#   sudo nano /etc/blockverify.env      then      sudo systemctl restart blockverify

PORT=5000

# Algorand Testnet wallet that pays for every anchor. Without it the server makes a new,
# empty wallet and every registration fails. Use the "private_key" value from your
# laptop's backend/data/algo_wallet.json (or set ALGO_MNEMONIC to the 25 words instead).
ALGO_PRIVATE_KEY=
ALGO_APP_ID=764828342

# Optional: the in-app assistant. Comma-separated Gemini API keys.
# GEMINI_API_KEYS=
